# CORE CPS V0.1 — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to source control

# Database — required
DATABASE_URL=postgresql://cps:cps_dev_password@localhost:5432/cps_dev

# Authentication — required
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET
NEXTAUTH_URL=http://localhost:3000

# Application
NEXT_PUBLIC_APP_NAME="CPS V0.1 (Prototype)"
NEXT_PUBLIC_APP_ENV=development

# File uploads
FILE_UPLOAD_MAX_MB=25
# For prototype: local filesystem. For production: replace with S3/Azure Blob config
FILE_UPLOAD_DIR=./uploads
# FILE_UPLOAD_PROVIDER=local        # local | s3 | azure
# FILE_UPLOAD_S3_BUCKET=
# FILE_UPLOAD_S3_REGION=

# Logging
LOG_LEVEL=info

# NODE_ENV
NODE_ENV=development
